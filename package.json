{
  "name": "dsh-plugin-wrapped",
  "version": "0.2.0",
  "type": "module",
  "description": "NetEase-style Wrapped for DeepSeek Harness: an interactive monthly / quarterly / yearly rewind of human-vs-AI conversations — auto-collected from every local session log, with the sentences you actually said. · 像网易云年度报告那样回顾你和 AI 的对话。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "cordis",
    "wrapped",
    "year-in-review",
    "rewind",
    "conversation-analytics",
    "usage-report"
  ],
  "license": "MIT",
  "author": "ErnestW2019",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ErnestW2019/dsh-plugin-wrapped.git"
  },
  "homepage": "https://github.com/ErnestW2019/dsh-plugin-wrapped#readme",
  "bugs": {
    "url": "https://github.com/ErnestW2019/dsh-plugin-wrapped/issues"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./lib/*": "./lib/*"
  },
  "bin": {
    "dsh-wrapped": "./bin/plugin.js",
    "dsh-plugin-wrapped": "./bin/plugin.js",
    "dsh-wrapped-report": "./bin/wrapped.js"
  },
  "files": [
    "index.js",
    "lib",
    "bin",
    "README.md",
    "docs/preview-year.png"
  ],
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "test": "node --test --test-isolation=none \"test/*.test.js\"",
    "preview": "node bin/wrapped.js",
    "report": "node bin/wrapped.js --period year --out report.html --json report.json",
    "install:profile": "node bin/plugin.js install",
    "uninstall:profile": "node bin/plugin.js uninstall",
    "prepublishOnly": "node --test --test-isolation=none \"test/*.test.js\""
  },
  "publishConfig": {
    "access": "public"
  }
}
