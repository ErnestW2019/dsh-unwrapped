{
  "name": "dsh-unwrapped",
  "version": "0.2.0",
  "type": "module",
  "description": "Unwrapped for DeepSeek Harness: an interactive monthly / quarterly / yearly report of human-vs-AI conversations — auto-collected from every local session log, with the sentences you actually said. · 给你和 AI 的对话一份网易云年度报告。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "cordis",
    "wrapped",
    "year-in-review",
    "rewind",
    "conversation-analytics",
    "usage-report"
  ],
  "license": "MIT",
  "author": "ErnestW2019",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ErnestW2019/dsh-unwrapped.git"
  },
  "homepage": "https://github.com/ErnestW2019/dsh-unwrapped#readme",
  "bugs": {
    "url": "https://github.com/ErnestW2019/dsh-unwrapped/issues"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./lib/*": "./lib/*"
  },
  "bin": {
    "dsh-unwrapped": "./bin/plugin.js",
    "dsh-unwrapped-report": "./bin/unwrapped.js"
  },
  "files": [
    "index.js",
    "lib",
    "bin",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "docs/preview-year.png",
    "docs/preview-year.gif"
  ],
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "test": "node --test",
    "preview": "node bin/unwrapped.js",
    "report": "node bin/unwrapped.js --period year --out report.html --json report.json",
    "install:profile": "node bin/plugin.js install",
    "uninstall:profile": "node bin/plugin.js uninstall",
    "prepublishOnly": "node --test"
  },
  "publishConfig": {
    "access": "public"
  }
}
